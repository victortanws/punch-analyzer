ADMIN_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Photos are ON by default here (pet photos are the point, and every one is human-reviewed).
# Set to 0 to accept name + words only.
# ALLOW_IMAGES=0
