# The Ledger of Vanity — environment template.
# Copy to your host's env vars (Railway → Variables). Never commit a filled-in .env.
# With STRIPE_SECRET_KEY unset the app runs in DEMO mode (simulated payments + seed data).

# Public origin, no trailing slash. Stripe success/cancel redirects use this.
BASE_URL=https://your-domain.example

# Where data.json + images/ live. On Railway, mount a volume and point this at it.
DATA_DIR=/data

# Stripe — test keys first, then live. Absent = demo mode.
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you register at /webhook/stripe (event checkout.session.completed).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Long random string; guards the review queue + moderation. WITHOUT it you cannot approve
# tributes (nothing will ever appear on the live ledger) or take content down.
# The Keeper's Desk is at /admin.html — paste this token there. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Shown in footer, legal page, and error messages.
CONTACT_EMAIL=you@your-domain.example

# Image uploads are OFF unless this is exactly "1". Leave unset for launch — accepting
# arbitrary user images with no content scanning is a serious liability. Enable only once
# you have a scanning + review process.
# ALLOW_IMAGES=1

# PORT is set automatically by most hosts; only set it for local runs.
# PORT=8751
